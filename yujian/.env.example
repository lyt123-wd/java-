# 复制为 .env 后修改；.env 不会被提交到 Git

# ---------- MySQL ----------
DB_NAME=yujian
DB_PASSWORD=yujian123
# 宿主机端口，避免和本机已有的 3306 冲突
DB_EXPOSE_PORT=3307

# ---------- Redis ----------
REDIS_EXPOSE_PORT=6379

# ---------- MinIO ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yujian
# 浏览器访问 MinIO 的地址；部署到服务器时改成 http://服务器IP:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- JWT ----------
# 生产环境务必替换为至少 32 字节的随机字符串
JWT_SECRET=please-change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=7d

# ---------- 阿里云短信（默认关闭，验证码打印到日志） ----------
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_TEMPLATE_CODE=SMS_154950909
SMS_SIGN_NAME=阿里云短信测试

# ---------- 端口 ----------
ADMIN_API_PORT=8080
APP_API_PORT=8081
ADMIN_WEB_PORT=80
H5_WEB_PORT=81
